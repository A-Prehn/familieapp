DEFINE SCHEMA

    RECORD TYPE "cloudkit.share" (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        "cloudkit.title" STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Family (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        name            STRING,
        ownerId         STRING,
        ownerName       STRING,
        premiumUntil    TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Child (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        familyRef       REFERENCE QUERYABLE,
        name            STRING,
        gender          STRING,
        birthDate       TIMESTAMP,
        dueDate         TIMESTAMP,
        photo           ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Highlight (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        childRef        REFERENCE QUERYABLE,
        date            TIMESTAMP,
        text            STRING,
        photos          LIST<ASSET>,
        video           ASSET,
        audio           ASSET,
        videoDuration   DOUBLE,
        audioDuration   DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Milestone (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        childRef        REFERENCE QUERYABLE,
        key             STRING,
        value           STRING,
        photo           ASSET,
        photos          LIST<ASSET>,
        captions        LIST<STRING>,
        coverIndex      INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Answer (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        childRef        REFERENCE QUERYABLE,
        question        STRING,
        answer          STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Diary (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        childRef        REFERENCE QUERYABLE,
        date            TIMESTAMP,
        text            STRING,
        photo           ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE GalleryItem (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        childRef        REFERENCE QUERYABLE,
        kind            STRING,
        caption         STRING,
        note            STRING,
        photo           ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Event (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        familyRef       REFERENCE QUERYABLE,
        title           STRING,
        date            TIMESTAMP,
        details         STRING,
        photo           ASSET,
        placeName       STRING,
        placeAddress    STRING,
        location        LOCATION,
        photos          LIST<ASSET>,
        captions        LIST<STRING>,
        coverIndex      INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Vacation (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        familyRef       REFERENCE QUERYABLE,
        title           STRING,
        startDate       TIMESTAMP,
        endDate         TIMESTAMP,
        details         STRING,
        photo           ASSET,
        placeName       STRING,
        placeAddress    STRING,
        location        LOCATION,
        photos          LIST<ASSET>,
        captions        LIST<STRING>,
        coverIndex      INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Measurement (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        childRef        REFERENCE QUERYABLE,
        date            TIMESTAMP,
        weightGrams     INT64,
        heightCm        DOUBLE,
        headCm          DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Letter (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        childRef        REFERENCE QUERYABLE,
        title           STRING,
        text            STRING,
        author          STRING,
        writtenAt       TIMESTAMP,
        openDate        TIMESTAMP,
        photo           ASSET,
        video           ASSET,
        videoDuration   DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Member (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        familyRef       REFERENCE QUERYABLE,
        userId          STRING,
        name            STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Birthday (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        familyRef       REFERENCE QUERYABLE,
        name            STRING,
        date            TIMESTAMP,
        emoji           STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Person (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        familyRef       REFERENCE QUERYABLE,
        name            STRING,
        birthDate       TIMESTAMP,
        deathDate       TIMESTAMP,
        role            STRING,
        photo           ASSET,
        parentIds       LIST<STRING>,
        partnerIds      LIST<STRING>,
        childId         STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Interview (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        childRef        REFERENCE QUERYABLE,
        age             INT64,
        question        STRING,
        text            STRING,
        date            TIMESTAMP,
        audio           ASSET,
        audioDuration   DOUBLE,
        video           ASSET,
        videoDuration   DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Tradition (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        familyRef       REFERENCE QUERYABLE,
        title           STRING,
        "when"          STRING,
        details         STRING,
        photos          LIST<ASSET>,
        captions        LIST<STRING>,
        coverIndex      INT64,
        photo           ASSET,
        audio           ASSET,
        audioDuration   DOUBLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
